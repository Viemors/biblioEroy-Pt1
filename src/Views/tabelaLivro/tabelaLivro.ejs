<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/tabela.css">
    <title>Dados do livro</title>
</head>
<body>
  <%-include("../partials/header")%>

    <%-include('../partials/navbar') %>
<main>
    <%for (let i = 0; i<result.length; i++) { %>
        <table>
        <thead>
            <tr>
                <%for (let c = 0; c<result[i].colunas.length; c++) { %>
                <th> <%=result[i].colunas[c].name%> </th>
                <%}%>
            </tr>
            </thead>
        Tabela <%=result[i].colunas[0].table%>
        <tbody>
            <% for (let r = 0; r<result[i].resultados.length; r++) { %>
            <tr>
                <% for (let t = 0; t<result[i].colunas.length; t++) { %>
                <td> <%=result[i].resultados[r][result[i].colunas[t].name]%></td>
                <%}%>
            </tr>
            <%}%> 
        </tbody>
    </table>
    <%}%>
</main>
<footer>
    <%-include('../partials/footer') %>
</footer>
</body>
</html>