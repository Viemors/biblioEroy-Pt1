<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Empréstimo</title>
    <link rel="stylesheet" href="/css/emprestimo.css">
    <link rel="stylesheet" href="../js/emprestimo.js">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@100..900&display=swap');
    </style>

</head>

<body>

    <%- include('../partials/header') %>

    <%-include("../partials/navbar") %>
        <section class="container my-5">
            <!-- Conteúdo principal -->
            <h2>Reserve seu livro</h2>
            <div>
                <!--Função para escolher para qual usuário vai emprestar o livro
                    Object.Keys -> é como se transformasse o json em arranjo (pq o json não pega o lenght)
                    Aí no option aparece o nome dos candango (usuários) e salva o id deles -->
                <label>Para qual usuário? </label>
                    <select name="Idleitor" id="select">
                    <option selected disabled>Selecione um usuário</option> <!--Criar as opções com base nos usuários cadastrados-->
                      <%for(let i = 0; i<Object.keys(todos).length; i++){%>
                        <option value=<%=todos[i].id%>> <%=todos[i].username%> </option>
                      <%}%>
                    </select>
                </br>
            </div>
    
            <!--Todos os forms tem os inputs invíveis com os valores do livro-->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <!-- Card: Dom Casmurro -->
                <div class="col">
                    <div class="card h-100">
                        <img src="../imagens/livros/machado/dom casmuro.webp" class="card-img-top"
                            alt="Capa do livro Dom Casmurro">
                        <form action="/addEmprestimo" method="POST" class="card-body">
                            <input type="hidden" name="titulo" value="Dom Casmurro"> <h5 class="card-title">Dom Casmurro</h5>
                            <input type="hidden" name="autor" value="Machado de Assis"> <p class="card-text">Autor: Machado de Assis</p>
                            <input type="hidden" name="categoria" value="Romance realista"> <p class="card-text">Gênero: Romance realista</p>
                            <input type="hidden" name="idleitor" value=0 class="idleitor">
                            <button  class="btn btn-outline-primary btn-curtir" data-titulo="Dom Casmurro"
                                id="button">Realizar
                                Empréstimo</button>
                        </form >
                    </div>
                </div>

                <!-- Card: O Cortiço -->
                <div class="col">
                    <div class="card h-100">
                        <img src="../imagens/livros/azevedo/o cortiço.webp" class="card-img-top"
                            alt="Capa do livro O Cortiço">
                        <form action="/addEmprestimo" method="POST" class="card-body">
                            <input type="hidden" name="titulo" value="O Cortiço"> <h5 class="card-title">O Cortiço</h5>
                            <input type="hidden" name="autor" value="Aluísio Azevedo"> <p class="card-text">Autor: Aluísio Azevedo</p>
                            <input type="hidden" name="categoria" value="Naturalismo"> <p class="card-text">Gênero: Naturalismo</p>
                            <input type="hidden" name="idleitor" value=0 class="idleitor">
                            <button type="submit" class="btn btn-outline-primary btn-curtir" id="button"
                                data-titulo="O Cortiço">Realizar
                                Empréstimo</button>
                        </form>
                    </div>
                </div>

                <!-- Card: Iracema -->
                <div class="col">
                    <div class="card h-100">
                        <img src="../imagens/livros/alencar/iracema.webp" class="card-img-top"
                            alt="Capa do livro Iracema">
                        <form action="/addEmprestimo" method="POST" class="card-body">
                            <input type="hidden" name="titulo" value="Iracema"> <h5 class="card-title">Iracema</h5>
                            <input type="hidden" name="autor" value="José de Alencar"> <p class="card-text">Autor: José de Alencar</p>
                            <input type="hidden" name="categoria" value="Romantismo"> <p class="card-text">Gênero: Romantismo</p>
                            <input type="hidden" name="idleitor" value=0 class="idleitor">
                            <button type="submit" class="btn btn-outline-primary btn-curtir" data-titulo="Iracema"
                                id="button">Realizar
                                Empréstimo</button>
                        </form>
                    </div>
                </div>

                <!-- Card: Memórias Póstumas -->
                <div class="col">
                    <div class="card h-100">
                        <img src="../imagens/livros/machado/memorias postumas.webp" class="card-img-top"
                            alt="Capa do livro Memórias Póstumas de Brás Cubas">
                        <form action="/addEmprestimo" method="POST" class="card-body">
                            <input type="hidden" name="titulo" value="Memórias Póstumas de Brás Cubas"> <h5 class="card-title">Memórias Póstumas de Brás Cubas</h5>
                            <input type="hidden" name="autor" value="Machado de Assis"> <p class="card-text">Autor: Machado de Assis</p>
                            <input type="hidden" name="categoria" value="Realismo"> <p class="card-text">Gênero: Realismo</p>
                            <input type="hidden" name="idleitor" value=0 class="idleitor">
                            <button type="submit" class="btn btn-outline-primary btn-curtir"
                                data-titulo="Memórias Póstumas de Brás Cubas" id="button">Realizar Empréstimo</button>
                        </form>
                    </div>
                </div>

                <!-- Card: A Moreninha -->
                <div class="col">
                    <div class="card h-100">
                        <img src="../imagens/livros/macedo/a moreninha.webp" class="card-img-top"
                            alt="Capa do livro A Moreninha">
                        <form action="/addEmprestimo" method="POST" class="card-body">
                            <input type="hidden" name="titulo" value="A Moreninha"> <h5 class="card-title">A Moreninha</h5>
                            <input type="hidden" name="autor" value="Joaquim Manuel de Macedo"> <p class="card-text">Autor: Joaquim Manuel de Macedo</p>
                            <input type="hidden" name="categoria" value="Romantismo"> <p class="card-text">Gênero: Romantismo</p>
                            <input type="hidden" name="idleitor" value=0 class="idleitor">
                            <button type="submit" class="btn btn-outline-primary btn-curtir" data-titulo="A Moreninha"
                                id="button">Realizar
                                Empréstimo</button>
                        </form>
                    </div>
                </div>

                <!-- Card: Vidas Secas -->
                <div class="col">
                    <div class="card h-100">
                        <img src="../imagens/livros/graciliano/vidas secas.webp" class="card-img-top"
                            alt="Capa do livro Vidas Secas">
                        <form action="/addEmprestimo" method="POST" class="card-body">
                            <input type="hidden" name="titulo" value="Vidas Secas"> <h5 class="card-title">Vidas Secas</h5>
                            <input type="hidden" name="autor" value="Graciliano Ramos"> <p class="card-text">Autor: Graciliano Ramos</p>
                            <input type="hidden" name="categoria" value="Romance regionalista"> <p class="card-text">Gênero: Romance regionalista</p>
                            <input type="hidden" name="idleitor" value=0 class="idleitor">
                            <button type="submit" class="btn btn-outline-primary btn-curtir" data-titulo="Vidas Secas"
                                id="button">Realizar
                                Empréstimo</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <section class="container my-5">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

                <form class="formi">
                    <h2>Empréstimo</h2>
                    <div class="slaa">
                        <label for="inputNome">Nome:</label>
                        <input type="text" placeholder="Digite o nome" required>
                    </div><br>

                    <div>
                        <label for="inputUsuario">Usuário:</label>
                        <input type="text" placeholder="Digite o nome de usuário" required>
                    </div><br>

                    <div>
                        <label for="inputUsuario">Email:</label>
                        <input type="text" placeholder="Digite seu email" required>
                    </div><br>

                    <div>
                        <label for="inputUsuario">Senha:</label>
                        <input type="text" placeholder="Digite sua senha" required>
                    </div><br>

                    <div>
                        <a href="/" class="btn btn-outline-primary btn-curtir" id="button">Editar</a>
                        <a href="/" class="btn btn-outline-primary btn-curtir" id="button">Enviar</a>
                        <a href="/" class="btn btn-outline-primary btn-curtir" id="button">Cancelar</a>
                    </div><br>
                </form>

                <details>
                    <summary style="font-size: 30px;">Devolução</summary>
                    <br>
                    <!--Por hora devolução tá sendo só apagar o emprestimo, só usa o nome do leitor e o titulo-->
                    <form action="/deleteEmprestimo" method="POST">
                        <div>
                            <label>Nome do Leitor:</label>
                            <input name="leitor" type="text" placeholder="Digite o nome">
                        </div><br>

                        <div>
                            <label>Título do Livro:</label>
                            <input name="titulo" type="text" placeholder="Digite o título do livro">
                        </div><br>

                        <div>
                            <label>Data do Empréstimo:</label>
                            <input type="date">
                        </div><br>

                        <div>
                            <label>Data da Devolução:</label>
                            <input type="date">
                        </div><br>

                        <div>
                            <label>Estado do Livro:</label>
                            <select>
                                <option>Bom estado</option>
                                <option>Com leves danos</option>
                                <option>Danificado</option>
                            </select>
                        </div><br>

                        <div>
                            <label>Observações:</label>
                            <textarea rows="3" placeholder="Ex: atraso, rasura..."></textarea>
                        </div><br>

                        <button type="submit" class="btn btn-outline-primary btn-curtir" id="button">Confirmar Devolução</button>
                    </form>
                </details>

                <br>

                </form>

            </div>
        </section>

        <%- include('../partials/footer') %>

        <!--Tentei quase tudo possível pra salvar esse IdLeitor em forms diferentes e não deu, aí apelei pra gambiarra hehe -->
        <script>
            const select = document.querySelector("#select")
            select.addEventListener("change", () => {
                const idleitor = document.querySelectorAll(".idleitor")
                idleitor.forEach(a => {
                    a.value = select.value
                }); 
            });
        </script>

</body>

</html>

<style>
    body {
        background-color: #f9f0e5;
        padding-top: 60px;
    }
</style>