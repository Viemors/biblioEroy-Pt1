<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Perfil</title>
  <link rel="stylesheet" href="../css/perfis.css">
  <link rel="stylesheet" href="../js/perfis.js">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@100..900&display=swap');
  </style>
</head>

<body>

  <h2>Meu Perfil</h2>
  <form>
    <div>
      <label for="inputNome">Nome</label>
      <input type="text" readonly>
    </div><br>

    <div>
      <label for="inputUsuario">Usuário</label>
      <input type="text" readonly>
    </div><br>

    <div>
      <label for="inputEmail">Email</label>
      <input type="email" readonly>
    </div><br>

    <div>
      <label for="inputSenha">Senha</label>
      <input type="password" readonly>
    </div><br>

    <i class="bi bi-journal-bookmark" style="font-size: 30px;"></i>

    <div>
      <button type="button">Editar</button>
      <button type="submit">Salvar</button>
      <button type="button">Cancelar</button>
    </div><br>

    <button type="button" id="btn-sair" class="btn btn-danger">Sair da Conta</button>

  </form>

</body>

</html>